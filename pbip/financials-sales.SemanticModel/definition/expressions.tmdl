/// Caminho do arquivo de amostra Financial Sample.xlsx (instalado com o Power BI Desktop)
expression path_arquivo_financeiro = "C:\Program Files\WindowsApps\Microsoft.MicrosoftPowerBIDesktop_2.159.883.0_x64__8wekyb3d8bbwe\bin\SampleData\Financial Sample.xlsx" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	queryGroup: Caminhos

/// Gera um calendário diário contínuo entre duas datas
expression fx_gera_calendario =
		(dt_inicio as date, dt_fim as date) as table =>
		let
			__QtdDias = Duration.Days(dt_fim - dt_inicio) + 1,
			__listaDatas = List.Dates(dt_inicio, __QtdDias, #duration(1, 0, 0, 0)),
			tabelaDatas = Table.FromList(__listaDatas, Splitter.SplitByNothing(), type table [pk_data = date]),
			comAno = Table.AddColumn(tabelaDatas, "nu_ano", each Date.Year([pk_data]), Int64.Type),
			comMes = Table.AddColumn(comAno, "nu_mes", each Date.Month([pk_data]), Int64.Type),
			comNomeMes = Table.AddColumn(comMes, "nm_mes", each Text.Replace(Text.Lower(Date.ToText([pk_data], [Format = "MMM", Culture = "pt-BR"])), ".", ""), type text),
			comAnoMes = Table.AddColumn(comNomeMes, "nu_ano_mes", each [nu_ano] * 100 + [nu_mes], Int64.Type),
			comMesAno = Table.AddColumn(comAnoMes, "ct_mes_ano", each [nm_mes] & "/" & Text.End(Text.From([nu_ano]), 2), type text),
			comTrimestre = Table.AddColumn(comMesAno, "nu_trimestre", each Date.QuarterOfYear([pk_data]), Int64.Type),
			comRotuloTrimestre = Table.AddColumn(comTrimestre, "ct_trimestre", each "T" & Text.From([nu_trimestre]), type text)
		in
			comRotuloTrimestre
	queryGroup: Funções

/// Camada 1: tabela "financials" do Excel, sem transformação
expression src_financeiro =
		let
			Source = Excel.Workbook(File.Contents(path_arquivo_financeiro), null, true),
			tabelaFinanceiro = Source{[Item = "financials", Kind = "Table"]}[Data]
		in
			tabelaFinanceiro
	queryGroup: Fontes

/// Camada 2: colunas renomeadas para a convenção, tipadas e com textos limpos
expression stg_financeiro =
		let
			Source = src_financeiro,
			colunasRenomeadas = Table.RenameColumns(Source, {{"Segment", "nm_segmento"}, {"Country", "nm_pais"}, {"Product", "nm_produto"}, {"Discount Band", "nm_faixa_desconto"}, {"Units Sold", "qt_unidades_vendidas"}, {"Manufacturing Price", "vl_preco_fabricacao"}, {"Sale Price", "vl_preco_venda"}, {"Gross Sales", "vl_receita_bruta"}, {"Discounts", "vl_desconto"}, {"Sales", "vl_receita_liquida"}, {"COGS", "vl_custo"}, {"Profit", "vl_lucro"}, {"Date", "dt_venda"}}),
			colunasSelecionadas = Table.SelectColumns(colunasRenomeadas, {"nm_segmento", "nm_pais", "nm_produto", "nm_faixa_desconto", "dt_venda", "qt_unidades_vendidas", "vl_preco_fabricacao", "vl_preco_venda", "vl_receita_bruta", "vl_desconto", "vl_receita_liquida", "vl_custo", "vl_lucro"}),
			tiposAjustados = Table.TransformColumnTypes(colunasSelecionadas, {{"nm_segmento", type text}, {"nm_pais", type text}, {"nm_produto", type text}, {"nm_faixa_desconto", type text}, {"dt_venda", type date}, {"qt_unidades_vendidas", Currency.Type}, {"vl_preco_fabricacao", Currency.Type}, {"vl_preco_venda", Currency.Type}, {"vl_receita_bruta", Currency.Type}, {"vl_desconto", Currency.Type}, {"vl_receita_liquida", Currency.Type}, {"vl_custo", Currency.Type}, {"vl_lucro", Currency.Type}}),
			textosLimpos = Table.TransformColumns(tiposAjustados, {{"nm_segmento", Text.Trim, type text}, {"nm_pais", Text.Trim, type text}, {"nm_produto", Text.Trim, type text}, {"nm_faixa_desconto", Text.Trim, type text}})
		in
			textosLimpos
	queryGroup: Staging
